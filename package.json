{
  "name": "stormwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prototype:mvp-feedback": "vite --host 127.0.0.1 --open /review/2026-09-25-mvp-feedback/index.html",
    "build": "tsc --noEmit && vite build && node tools/check-production-artifact.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests tools/*.mjs *.ts *.html",
    "format:check": "prettier --check src tests tools/*.mjs *.ts *.html",
    "dev:workbench": "vite --host 127.0.0.1 --mode workbench --open /workbench.html",
    "build:workbench": "tsc --noEmit && vite build --mode workbench",
    "build:qa": "tsc --noEmit && vite build --mode qa",
    "check:artifact": "node tools/check-production-artifact.mjs",
    "workbench:promote": "node tools/promote-workbench.mjs"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "prettier": "3.9.8",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
